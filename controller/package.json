{
  "name": "ameise",
  "version": "0.1.0",
  "private": true,
  "description": "The local workflow: a controller that claims GitHub issues into headless Claude Code sessions, with its dashboard and the worker, planner and repo-standards plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalvinDittkrist/workflows.git",
    "directory": "controller"
  },
  "homepage": "https://github.com/CalvinDittkrist/workflows#readme",
  "type": "module",
  "bin": {
    "ameise": "dist/main.js"
  },
  "files": [
    "dist",
    "fake"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-plugins.mjs",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node scripts/check-pack.mjs",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283"
  }
}
