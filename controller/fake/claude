#!/usr/bin/env bash
# The scripted claude of the controller's fake mode (ameise --fake): the runtime the Agent SDK starts
# in place of the machine's claude. It speaks the SDK's stream-json protocol on stdin and stdout and plays
# the session a canned directory names. The real server so runs a session with no model behind it.
#
#   AMEISE_FAKE_CLAUDE      the canned runtime; without it, or without a play in it, the session holds
#     play                     the session to play, one step a line; the first word of a line is the step
#     <stage>                  the session to play in that stage of a work process, which AMEISE_STAGE
#                              names, such as gate for a fix session of the gate; without it play
#                              (address-reviews for the session that answers a review, which
#                              reports its replies, its answer and the points it fixed and declined)
#     reviewer-<name>          the session a reviewer of that name plays, such as reviewer-code; without
#                              it reviewer, and without that it reports verdict pass
#     author                   the session the author of the pull request plays; without it, it reports
#                              pull Fake pull request
#     checker                  the session the spec checker of an acceptance plays; without it, it
#                              reports one item met, one missing, one deviating and one untested
#     resume                   the session to play when it is resumed with --resume <id>, whose id it
#                              keeps; without it a resumed session plays its stage's or play
#     linger                   while it is there, a session that has reported its end has not exited yet
#   AMEISE_FAKE_CLAUDE_LOG  its arguments, one per line, then every line it reads, each after '< ';
#                              beside it, <log>.env holds the environment of every session it started
#
# The session says "Working on it." when its first message arrives, then plays its steps in order:
#   say <text>          it writes the text
#   usage <tokens>      its messages from here on used that many tokens of input
#   permit <command>    it asks for the permission to run the command in Bash, then says whether it ran
#   ask <question>      it asks the question with the options Keep and Drop, then says the answer
#   choose <question>   it asks the question with the options Keep and Drop, of which any may be chosen,
#                       then says the answer
#   wait                it waits for the next message, then says what it read
#   commit <file>       it writes the file in its directory and commits it
#   run <command>       it runs the command in its directory with bash, whatever it exits with
#   bash <command>      it asks the PreToolUse hook of Bash the SDK registered whether it may run the
#                       command in Bash, then says whether the hook denied it; it never runs it
#   tool <name> <json>  it calls the tool of that name of the controller's in-process server github with
#                       the arguments given as JSON, then says what the tool answered
#   finding <severity> <where> <claim>
#                       a reviewer's finding, such as finding S2 src/a.ts:3 The limit is off by one
#   fixed <id> <note>   a fix session of the review fixed the finding of that id; an address-reviews
#                       session reports the whole line as a point it fixed
#   declined <id> <note>  it declined the finding of that id, or the point
#   reply <thread> <body>  an address-reviews session replies to the thread of that id
#   answer <text>       an address-reviews session answers the requests for changes with the text
#   body <line>         a line of the body of the pull request the author reports
#   item <section> | <statement> | <verdict> | <evidence> | <confidence>
#                       an item the spec checker reports, such as
#                       item Testing | The board is tested | met | test/board.test.ts:1 | high
# A line with one of these words ends it:
#   complete <message>  it reports complete with the message and the commits it made since it started
#   ready <message>     it reports ready with the message, which is also the text of its result
#   blocked <message>   it reports blocked with the message as its question and the commits it made
#   verdict <pass|fix>  a reviewer reports the verdict with its findings
#   pull <title>        the author reports the pull request with the title and its body lines
#   items               the spec checker reports its items
#   silent              it ends without a result
#   broken <message>    the runtime cannot start: it prints the message on stderr and exits 1
#   litter <file>       it runs until its input closes, then writes <file> in its directory and leaves
#                       it uncommitted, as a session stopped mid-change does
# Without an end it runs until its input closes, as a long session does.
#
# Claude Code hands the result of an output schema over through its StructuredOutput tool. A session
# started with --agent whose tools list leaves that tool out ends with text alone and no structured
# result (tried with Claude Code 2.1.285 on 2026-09-30), so this one does too. It reads the agent from
# the plugins of --plugin-dir: worker:code-reviewer is agents/code-reviewer.md of the plugin named
# worker, a name without a plugin is that file of any of them.
#
# --version answers as a claude does, whatever the play.
set -euo pipefail

log=${AMEISE_FAKE_CLAUDE_LOG:-/dev/null}
if [ "${1:-}" = --version ]; then
  printf '2.0.0 (Claude Code, ameise fake)\n'
  exit 0
fi
# Reviewers start at once, and printf flushes a long argument list in several writes that interleave
# with theirs. cat appends the whole list in one write, so the arguments of one session stay together.
cat <<<"$(printf '%s\n' "$@")" >> "$log"
if [ "$log" != /dev/null ]; then cat <<<"$(export -p)" >> "$log.env"; fi

# A session is named by its pid, and a resumed one keeps the id it resumes.
session=fake-session-$$
file=play
previous=''
agent=''
plugins=()
for arg in "$@"; do
  case "$previous $arg" in
    '--resume '*) session=$arg && file=resume ;;
    *' --resume='*) session=${arg#--resume=} && file=resume ;;
    '--agent '*) agent=$arg ;;
    '--plugin-dir '*) plugins+=("$arg") ;;
  esac
  previous=$arg
done

# structured says the session can report a structured result: no agent, or an agent whose tools list
# names StructuredOutput or is absent.
structured=1
if [ -n "$agent" ]; then
  for dir in "${plugins[@]+"${plugins[@]}"}"; do
    name=''
    manifest=''
    if [ -f "$dir/.claude-plugin/plugin.json" ]; then manifest=$(<"$dir/.claude-plugin/plugin.json"); fi
    if [[ $manifest =~ \"name\":[[:space:]]*\"([^\"]*)\" ]]; then name=${BASH_REMATCH[1]}; fi
    case "$agent" in
      *:*) if [ "$name" != "${agent%%:*}" ]; then continue; fi ;;
    esac
    definition="$dir/agents/${agent#*:}.md"
    if [ ! -f "$definition" ]; then continue; fi
    # The tools line of the frontmatter, the lines between the first two --- lines.
    tools='' fence=0
    while IFS= read -r l; do
      if [ "$l" = --- ]; then
        fence=$((fence + 1))
        if [ $fence -eq 2 ]; then break; fi
        continue
      fi
      case "$l" in tools:*) tools=$l && break ;; esac
    done < "$definition"
    case "$tools" in
      '' | *StructuredOutput*) ;;
      *) structured='' ;;
    esac
    break
  done
fi

steps=()
canned=${AMEISE_FAKE_CLAUDE:-}
if [ "$file" = resume ] && { [ -z "$canned" ] || [ ! -f "$canned/resume" ]; }; then file=play; fi
stage=${AMEISE_STAGE:-}
case "$stage" in play | resume | linger | '' | */*) ;; *) if [ "$file" = play ] && [ -n "$canned" ] && [ -f "$canned/$stage" ]; then file=$stage; fi ;; esac
# A reviewer plays its own file, else the one of every reviewer, else a pass.
case "$stage" in
  reviewer-*)
    if [ "$file" != "$stage" ]; then file=reviewer; fi
    if [ -z "$canned" ] || [ ! -f "$canned/$file" ]; then file=''; steps=('verdict pass'); fi ;;
  author)
    if [ "$file" != author ]; then file=''; steps=('pull Fake pull request'); fi ;;
  checker)
    if [ "$file" != checker ]; then
      file=''
      steps=(
        'item User stories | The board lists the specs ready for acceptance | met | controller/src/board.ts:1 | high'
        'item User stories | An acceptance starts from the board with one action | missing | searched controller/src for an acceptance start and found none | medium'
        'item Decisions | The checker runs read-only | deviates | controller/src/session.ts:1 lets it run Bash | low'
        'item Testing | Fake mode scripts the checker | untested | controller/fake/claude:1 | high'
        'items'
      )
    fi ;;
esac
if [ -n "$file" ] && [ -n "$canned" ] && [ -f "$canned/$file" ]; then
  while IFS= read -r step || [ -n "$step" ]; do
    if [ -n "$step" ]; then steps+=("$step"); fi
  done < "$canned/$file"
fi
last=''
if [ ${#steps[@]} -gt 0 ]; then last=${steps[${#steps[@]}-1]}; fi
ending=''
case "${last%% *}" in complete | ready | blocked | silent | broken | litter | verdict | pull | items) ending=$last ;; esac
word=${ending%% *}
message=''
case "$ending" in *' '*) message=${ending#* } ;; esac

if [ "$word" = broken ]; then
  printf '%s\n' "$message" >&2
  exit 1
fi

# json quotes a string for JSON: backslash and double quote escaped, control characters dropped.
json() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//[[:cntrl:]]/}
  printf '"%s"' "$s"
}

# result writes the result of the session with the structured result given as JSON, which it leaves
# out when the session cannot report one.
result() {
  local out=''
  if [ -n "$structured" ]; then out=",\"structured_output\":$1"; fi
  say "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"$session\",\"uuid\":\"$session-result\",\"duration_ms\":1,\"duration_api_ms\":1,\"num_turns\":1,\"result\":$(json "$message"),\"stop_reason\":\"end_turn\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"modelUsage\":{},\"permission_denials\":[]$out}"
}

say() { printf '%s\n' "$1"; }
n=0
tokens=1
# findings are a reviewer's findings, fixes what a fix session of the review did with each, as JSON.
findings=''
fixes=''
body=''
# items are the items the spec checker reports, as JSON.
items=''
# replies, answer, fixedl and declinedl are what an address-reviews session reports.
replies=''
answer=''
fixedl=''
declinedl=''

# assistant writes a message of the session with the content blocks given as JSON.
assistant() {
  n=$((n + 1))
  say "{\"type\":\"assistant\",\"session_id\":\"$session\",\"uuid\":\"$session-$n\",\"parent_tool_use_id\":null,\"message\":{\"id\":\"msg-$n\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"fake\",\"content\":[$1],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":$tokens,\"output_tokens\":1}}}"
}
text() { assistant "{\"type\":\"text\",\"text\":$(json "$1")}"; }

# field reads the string after "<name>":" in a line, up to the next quote.
field() {
  local rest=${2#*"\"$1\":\""}
  if [ "$rest" = "$2" ]; then return 0; fi
  printf '%s' "${rest%%\"*}"
}

# hook is the callback id of the PreToolUse hook of Bash the SDK registered in its initialize request.
hook=''
# next reads one line of input, answers the SDK's initialize request, and fails once the input closes.
next() {
  IFS= read -r line || return 1
  printf '< %s\n' "$line" >> "$log"
  case "$line" in
    *'"subtype":"initialize"'*)
      if [[ $line =~ \"PreToolUse\":\[\{\"matcher\":\"Bash\",\"hookCallbackIds\":\[\"([^\"]*)\" ]]; then hook=${BASH_REMATCH[1]}; fi
      say "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(field request_id "$line")\",\"response\":{}}}" ;;
  esac
}

# A message that arrives while the session waits for an answer is kept for the next wait.
kept=''
# answer waits for the SDK's answer to the control request with the given id and leaves it in $line.
answer() {
  while next; do
    case "$line" in
      *'"type":"control_response"'*"\"request_id\":\"$1\""*) return 0 ;;
      *'"type":"user"'*) kept=$(field content "$line") ;;
    esac
  done
  return 1
}

# ask sends a permission request of the tool with the input, the suggestions and the reason.
ask() {
  local tool=$1 input=$2 suggestions=$3
  n=$((n + 1))
  assistant "{\"type\":\"tool_use\",\"id\":\"toolu-$n\",\"name\":\"$tool\",\"input\":$input}"
  say "{\"type\":\"control_request\",\"request_id\":\"ask-$n\",\"request\":{\"subtype\":\"can_use_tool\",\"tool_name\":\"$tool\",\"input\":$input,\"tool_use_id\":\"toolu-$n\",\"permission_suggestions\":$suggestions,\"decision_reason\":\"The classifier did not settle it.\"}}"
  answer "ask-$n"
}

# mcp sends a message of the in-process server github to the SDK and leaves its answer in $line. The
# first one initializes the server, as Claude Code does before it lists or calls its tools.
mcpready=''
mcp() {
  if [ -z "$mcpready" ]; then
    mcpready=1
    mcp '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"fake","version":"0"}}}' || return 1
  fi
  n=$((n + 1))
  say "{\"type\":\"control_request\",\"request_id\":\"mcp-$n\",\"request\":{\"subtype\":\"mcp_message\",\"server_name\":\"github\",\"message\":$1}}"
  answer "mcp-$n"
}

play() {
  local step rest
  for step in "${steps[@]+"${steps[@]}"}"; do
    rest=''
    case "$step" in *' '*) rest=${step#* } ;; esac
    case "${step%% *}" in
      say) text "$rest" ;;
      usage) tokens=$rest ;;
      permit)
        ask Bash "{\"command\":$(json "$rest")}" "[{\"type\":\"addRules\",\"rules\":[{\"toolName\":\"Bash\",\"ruleContent\":$(json "$rest")}],\"behavior\":\"allow\",\"destination\":\"localSettings\"}]" || return 1
        case "$line" in
          *'"behavior":"allow"'*) text "Ran $rest." ;;
          *) text "Did not run $rest." ;;
        esac ;;
      ask | choose)
        local multi=false
        if [ "${step%% *}" = choose ]; then multi=true; fi
        ask AskUserQuestion "{\"questions\":[{\"question\":$(json "$rest"),\"header\":\"Question\",\"options\":[{\"label\":\"Keep\",\"description\":\"Keep it as it is.\"},{\"label\":\"Drop\",\"description\":\"Take it out.\"}],\"multiSelect\":$multi}]}" '[]' || return 1
        local answers=${line#*\"answers\":\{}
        text "You answered: $(field "$rest" "{$answers")." ;;
      commit)
        printf '%s\n' "$rest" > "$rest"
        git add -- "$rest" && git commit -q -m "fix: write $rest" >/dev/null ;;
      run)
        bash -c "$rest" >/dev/null 2>&1 || true ;;
      bash)
        n=$((n + 1))
        local input
        input="{\"command\":$(json "$rest")}"
        assistant "{\"type\":\"tool_use\",\"id\":\"toolu-$n\",\"name\":\"Bash\",\"input\":$input}"
        if [ -z "$hook" ]; then
          text "No hook for $rest."
        else
          say "{\"type\":\"control_request\",\"request_id\":\"hook-$n\",\"request\":{\"subtype\":\"hook_callback\",\"callback_id\":\"$hook\",\"input\":{\"hook_event_name\":\"PreToolUse\",\"session_id\":\"$session\",\"transcript_path\":\"\",\"cwd\":$(json "$PWD"),\"tool_name\":\"Bash\",\"tool_input\":$input,\"tool_use_id\":\"toolu-$n\"},\"tool_use_id\":\"toolu-$n\"}}"
          answer "hook-$n" || return 1
          case "$line" in
            *'"permissionDecision":"deny"'*) text "The hook denied $rest." ;;
            *) text "The hook let $rest through." ;;
          esac
        fi ;;
      tool)
        local name=${rest%% *} args=${rest#* }
        n=$((n + 1))
        assistant "{\"type\":\"tool_use\",\"id\":\"toolu-$n\",\"name\":\"mcp__github__$name\",\"input\":$args}"
        mcp "{\"jsonrpc\":\"2.0\",\"id\":$n,\"method\":\"tools/call\",\"params\":{\"name\":\"$name\",\"arguments\":$args}}" || return 1
        case "$line" in
          *'"isError":true'*) text "The tool $name refused." ;;
          *'"result"'*) text "The tool $name answered." ;;
          *) text "The tool $name is not there." ;;
        esac ;;
      finding)
        local severity=${rest%% *} where claim
        rest=${rest#* }
        where=${rest%% *}
        claim=${rest#* }
        findings="$findings${findings:+,}{\"severity\":$(json "$severity"),\"where\":$(json "$where"),\"claim\":$(json "$claim"),\"fix\":\"Fix it.\"}" ;;
      item)
        local f=() part
        IFS='|' read -r -a f <<<"$rest"
        local fields=''
        local names=(section statement verdict evidence confidence)
        local i
        for i in 0 1 2 3 4; do
          part=${f[$i]:-}
          part=${part#"${part%%[![:space:]]*}"}
          part=${part%"${part##*[![:space:]]}"}
          fields="$fields${fields:+,}\"${names[$i]}\":$(json "$part")"
        done
        items="$items${items:+,}{$fields}" ;;
      body)
        local line
        line=$(json "$rest")
        line=${line#\"}
        body="$body${body:+\\n}${line%\"}" ;;
      fixed | declined)
        fixes="$fixes${fixes:+,}{\"finding\":$(json "${rest%% *}"),\"outcome\":\"${step%% *}\",\"note\":$(json "${rest#* }")}"
        if [ "${step%% *}" = fixed ]; then fixedl="$fixedl${fixedl:+,}$(json "$rest")"; else declinedl="$declinedl${declinedl:+,}$(json "$rest")"; fi ;;
      reply)
        replies="$replies${replies:+,}{\"thread\":$(json "${rest%% *}"),\"body\":$(json "${rest#* }")}" ;;
      answer)
        answer=$rest ;;
      wait)
        if [ -z "$kept" ]; then
          while next; do
            case "$line" in *'"type":"user"'*) kept=$(field content "$line") && break ;; esac
          done
        fi
        text "You wrote: $kept."
        kept='' ;;
    esac
  done
}

# The SDK sends its initialize request, then the first message; the session answers the one and plays
# the other.
while next; do
  case "$line" in
    *'"type":"user"'*)
      say "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"$session\",\"uuid\":\"$session-init\",\"cwd\":$(json "$PWD"),\"tools\":[],\"mcp_servers\":[],\"model\":\"fake\",\"permissionMode\":\"auto\",\"slash_commands\":[],\"apiKeySource\":\"none\",\"output_style\":\"default\"}"
      start=$(git rev-parse -q --verify HEAD 2>/dev/null || true)
      text 'Working on it.'
      play || break
      commits=''
      if [ -n "$start" ]; then
        while IFS= read -r c; do
          if [ -n "$c" ]; then commits="$commits${commits:+,}$(json "$c")"; fi
        done < <(git log --reverse --format='%h %s' "$start..HEAD" 2>/dev/null)
      fi
      case "$word" in
        complete)
          if [ "$stage" = address-reviews ]; then
            result "{\"outcome\":\"complete\",\"commits\":[$commits],\"message\":$(json "$message"),\"replies\":[$replies],\"answer\":$(json "$answer"),\"fixed\":[$fixedl],\"declined\":[$declinedl]}"
          else
            result "{\"outcome\":\"complete\",\"commits\":[$commits],\"message\":$(json "$message")${fixes:+,\"fixes\":[$fixes]}}"
          fi
          exit 0 ;;
        ready | blocked)
          result "{\"outcome\":\"$word\",\"commits\":[$commits],\"message\":$(json "$message")}"
          # A lingering runtime shrugs off the SDK's TERM as it closes the session.
          trap '' TERM
          while [ -n "$canned" ] && [ -f "$canned/linger" ]; do /bin/sleep 0.05; done
          exit 0 ;;
        verdict)
          result "{\"verdict\":$(json "$message"),\"findings\":[$findings]}"
          exit 0 ;;
        items)
          result "{\"items\":[$items]}"
          exit 0 ;;
        pull)
          say "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"$session\",\"uuid\":\"$session-result\",\"duration_ms\":1,\"duration_api_ms\":1,\"num_turns\":1,\"result\":$(json "$message"),\"stop_reason\":\"end_turn\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"modelUsage\":{},\"permission_denials\":[],\"structured_output\":{\"title\":$(json "$message"),\"body\":\"${body:-The change.}\"}}"
          exit 0 ;;
        silent)
          exit 0 ;;
      esac
      break ;;
  esac
done
# The session runs until its input closes.
while next; do :; done

# A littering session leaves a change behind as it is stopped.
if [ "$word" = litter ]; then printf 'unfinished\n' > "$message"; fi
