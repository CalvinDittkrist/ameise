#!/usr/bin/env bash
# The scripted claude of the controller's fake mode (ameise --fake): the runtime the Agent SDK starts
# in place of the machine's claude. It speaks the SDK's stream-json protocol on stdin and stdout and plays
# the session a canned directory names. The real server so runs a session with no model behind it.
#
#   AMEISE_FAKE_CLAUDE      the canned runtime; without it, or without a play in it, the session holds
#     play                     the session to play, one step a line; the first word of a line is the step
#     <stage>                  the session to play in that stage of a work process, which AMEISE_STAGE
#                              names, such as gate for a fix session of the gate; without it play
#     reviewer-<name>          the session a reviewer of that name plays, such as reviewer-code; without
#                              it reviewer, and without that it reports verdict pass
#     resume                   the session to play when it is resumed with --resume <id>, whose id it
#                              keeps; without it a resumed session plays its stage's or play
#     linger                   while it is there, a session that has reported its end has not exited yet
#   AMEISE_FAKE_CLAUDE_LOG  its arguments, one per line, then every line it reads, each after '< ';
#                              beside it, <log>.env holds the environment of every session it started
#
# The session says "Working on it." when its first message arrives, then plays its steps in order:
#   say <text>          it writes the text
#   usage <tokens>      its messages from here on used that many tokens of input
#   permit <command>    it asks for the permission to run the command in Bash, then says whether it ran
#   ask <question>      it asks the question with the options Keep and Drop, then says the answer
#   choose <question>   it asks the question with the options Keep and Drop, of which any may be chosen,
#                       then says the answer
#   wait                it waits for the next message, then says what it read
#   commit <file>       it writes the file in its directory and commits it
#   run <command>       it runs the command in its directory with bash, whatever it exits with
#   finding <severity> <where> <claim>
#                       a reviewer's finding, such as finding S2 src/a.ts:3 The limit is off by one
#   fixed <id> <note>   a fix session of the review fixed the finding of that id
#   declined <id> <note>  it declined the finding of that id
# A line with one of these words ends it:
#   complete <message>  it reports complete with the message and the commits it made since it started
#   ready <message>     it reports ready with the message, which is also the text of its result
#   blocked <message>   it reports blocked with the message as its question and the commits it made
#   verdict <pass|fix>  a reviewer reports the verdict with its findings
#   silent              it ends without a result
#   broken <message>    the runtime cannot start: it prints the message on stderr and exits 1
#   litter <file>       it runs until its input closes, then writes <file> in its directory and leaves
#                       it uncommitted, as a session stopped mid-change does
# Without an end it runs until its input closes, as a long session does.
#
# --version answers as a claude does, whatever the play.
set -euo pipefail

log=${AMEISE_FAKE_CLAUDE_LOG:-/dev/null}
if [ "${1:-}" = --version ]; then
  printf '2.0.0 (Claude Code, ameise fake)\n'
  exit 0
fi
printf '%s\n' "$@" >> "$log"
if [ "$log" != /dev/null ]; then export -p >> "$log.env"; fi

# A session is named by its pid, and a resumed one keeps the id it resumes.
session=fake-session-$$
file=play
previous=''
for arg in "$@"; do
  case "$previous $arg" in
    '--resume '*) session=$arg && file=resume ;;
    *' --resume='*) session=${arg#--resume=} && file=resume ;;
  esac
  previous=$arg
done

steps=()
canned=${AMEISE_FAKE_CLAUDE:-}
if [ "$file" = resume ] && { [ -z "$canned" ] || [ ! -f "$canned/resume" ]; }; then file=play; fi
stage=${AMEISE_STAGE:-}
case "$stage" in play | resume | linger | '' | */*) ;; *) if [ "$file" = play ] && [ -n "$canned" ] && [ -f "$canned/$stage" ]; then file=$stage; fi ;; esac
# A reviewer plays its own file, else the one of every reviewer, else a pass.
case "$stage" in
  reviewer-*)
    if [ "$file" != "$stage" ]; then file=reviewer; fi
    if [ -z "$canned" ] || [ ! -f "$canned/$file" ]; then file=''; steps=('verdict pass'); fi ;;
esac
if [ -n "$file" ] && [ -n "$canned" ] && [ -f "$canned/$file" ]; then
  while IFS= read -r step || [ -n "$step" ]; do
    if [ -n "$step" ]; then steps+=("$step"); fi
  done < "$canned/$file"
fi
last=''
if [ ${#steps[@]} -gt 0 ]; then last=${steps[${#steps[@]}-1]}; fi
ending=''
case "${last%% *}" in complete | ready | blocked | silent | broken | litter | verdict) ending=$last ;; esac
word=${ending%% *}
message=''
case "$ending" in *' '*) message=${ending#* } ;; esac

if [ "$word" = broken ]; then
  printf '%s\n' "$message" >&2
  exit 1
fi

# json quotes a string for JSON: backslash and double quote escaped, control characters dropped.
json() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//[[:cntrl:]]/}
  printf '"%s"' "$s"
}

say() { printf '%s\n' "$1"; }
n=0
tokens=1
# findings are a reviewer's findings, fixes what a fix session of the review did with each, as JSON.
findings=''
fixes=''

# assistant writes a message of the session with the content blocks given as JSON.
assistant() {
  n=$((n + 1))
  say "{\"type\":\"assistant\",\"session_id\":\"$session\",\"uuid\":\"$session-$n\",\"parent_tool_use_id\":null,\"message\":{\"id\":\"msg-$n\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"fake\",\"content\":[$1],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":$tokens,\"output_tokens\":1}}}"
}
text() { assistant "{\"type\":\"text\",\"text\":$(json "$1")}"; }

# field reads the string after "<name>":" in a line, up to the next quote.
field() {
  local rest=${2#*"\"$1\":\""}
  if [ "$rest" = "$2" ]; then return 0; fi
  printf '%s' "${rest%%\"*}"
}

# next reads one line of input, answers the SDK's initialize request, and fails once the input closes.
next() {
  IFS= read -r line || return 1
  printf '< %s\n' "$line" >> "$log"
  case "$line" in
    *'"subtype":"initialize"'*)
      say "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(field request_id "$line")\",\"response\":{}}}" ;;
  esac
}

# A message that arrives while the session waits for an answer is kept for the next wait.
kept=''
# answer waits for the SDK's answer to the control request with the given id and leaves it in $line.
answer() {
  while next; do
    case "$line" in
      *'"type":"control_response"'*"\"request_id\":\"$1\""*) return 0 ;;
      *'"type":"user"'*) kept=$(field content "$line") ;;
    esac
  done
  return 1
}

# ask sends a permission request of the tool with the input, the suggestions and the reason.
ask() {
  local tool=$1 input=$2 suggestions=$3
  n=$((n + 1))
  assistant "{\"type\":\"tool_use\",\"id\":\"toolu-$n\",\"name\":\"$tool\",\"input\":$input}"
  say "{\"type\":\"control_request\",\"request_id\":\"ask-$n\",\"request\":{\"subtype\":\"can_use_tool\",\"tool_name\":\"$tool\",\"input\":$input,\"tool_use_id\":\"toolu-$n\",\"permission_suggestions\":$suggestions,\"decision_reason\":\"The classifier did not settle it.\"}}"
  answer "ask-$n"
}

play() {
  local step rest
  for step in "${steps[@]+"${steps[@]}"}"; do
    rest=''
    case "$step" in *' '*) rest=${step#* } ;; esac
    case "${step%% *}" in
      say) text "$rest" ;;
      usage) tokens=$rest ;;
      permit)
        ask Bash "{\"command\":$(json "$rest")}" "[{\"type\":\"addRules\",\"rules\":[{\"toolName\":\"Bash\",\"ruleContent\":$(json "$rest")}],\"behavior\":\"allow\",\"destination\":\"localSettings\"}]" || return 1
        case "$line" in
          *'"behavior":"allow"'*) text "Ran $rest." ;;
          *) text "Did not run $rest." ;;
        esac ;;
      ask | choose)
        local multi=false
        if [ "${step%% *}" = choose ]; then multi=true; fi
        ask AskUserQuestion "{\"questions\":[{\"question\":$(json "$rest"),\"header\":\"Question\",\"options\":[{\"label\":\"Keep\",\"description\":\"Keep it as it is.\"},{\"label\":\"Drop\",\"description\":\"Take it out.\"}],\"multiSelect\":$multi}]}" '[]' || return 1
        local answers=${line#*\"answers\":\{}
        text "You answered: $(field "$rest" "{$answers")." ;;
      commit)
        printf '%s\n' "$rest" > "$rest"
        git add -- "$rest" && git commit -q -m "fix: write $rest" >/dev/null ;;
      run)
        bash -c "$rest" >/dev/null 2>&1 || true ;;
      finding)
        local severity=${rest%% *} where claim
        rest=${rest#* }
        where=${rest%% *}
        claim=${rest#* }
        findings="$findings${findings:+,}{\"severity\":$(json "$severity"),\"where\":$(json "$where"),\"claim\":$(json "$claim"),\"fix\":\"Fix it.\"}" ;;
      fixed | declined)
        fixes="$fixes${fixes:+,}{\"finding\":$(json "${rest%% *}"),\"outcome\":\"${step%% *}\",\"note\":$(json "${rest#* }")}" ;;
      wait)
        if [ -z "$kept" ]; then
          while next; do
            case "$line" in *'"type":"user"'*) kept=$(field content "$line") && break ;; esac
          done
        fi
        text "You wrote: $kept."
        kept='' ;;
    esac
  done
}

# The SDK sends its initialize request, then the first message; the session answers the one and plays
# the other.
while next; do
  case "$line" in
    *'"type":"user"'*)
      say "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"$session\",\"uuid\":\"$session-init\",\"cwd\":$(json "$PWD"),\"tools\":[],\"mcp_servers\":[],\"model\":\"fake\",\"permissionMode\":\"auto\",\"slash_commands\":[],\"apiKeySource\":\"none\",\"output_style\":\"default\"}"
      start=$(git rev-parse -q --verify HEAD 2>/dev/null || true)
      text 'Working on it.'
      play || break
      commits=''
      if [ -n "$start" ]; then
        while IFS= read -r c; do
          if [ -n "$c" ]; then commits="$commits${commits:+,}$(json "$c")"; fi
        done < <(git log --reverse --format='%h %s' "$start..HEAD" 2>/dev/null)
      fi
      case "$word" in
        complete)
          say "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"$session\",\"uuid\":\"$session-result\",\"duration_ms\":1,\"duration_api_ms\":1,\"num_turns\":1,\"result\":$(json "$message"),\"stop_reason\":\"end_turn\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"modelUsage\":{},\"permission_denials\":[],\"structured_output\":{\"outcome\":\"complete\",\"commits\":[$commits],\"message\":$(json "$message")${fixes:+,\"fixes\":[$fixes]}}}"
          exit 0 ;;
        ready | blocked)
          say "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"$session\",\"uuid\":\"$session-result\",\"duration_ms\":1,\"duration_api_ms\":1,\"num_turns\":1,\"result\":$(json "$message"),\"stop_reason\":\"end_turn\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"modelUsage\":{},\"permission_denials\":[],\"structured_output\":{\"outcome\":\"$word\",\"commits\":[$commits],\"message\":$(json "$message")}}"
          # A lingering runtime shrugs off the SDK's TERM as it closes the session.
          trap '' TERM
          while [ -n "$canned" ] && [ -f "$canned/linger" ]; do /bin/sleep 0.05; done
          exit 0 ;;
        verdict)
          say "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"session_id\":\"$session\",\"uuid\":\"$session-result\",\"duration_ms\":1,\"duration_api_ms\":1,\"num_turns\":1,\"result\":$(json "$message"),\"stop_reason\":\"end_turn\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"modelUsage\":{},\"permission_denials\":[],\"structured_output\":{\"verdict\":$(json "$message"),\"findings\":[$findings]}}"
          exit 0 ;;
        silent)
          exit 0 ;;
      esac
      break ;;
  esac
done
# The session runs until its input closes.
while next; do :; done

# A littering session leaves a change behind as it is stopped.
if [ "$word" = litter ]; then printf 'unfinished\n' > "$message"; fi
