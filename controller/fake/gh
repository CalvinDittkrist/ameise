#!/usr/bin/env bash
# The scripted gh of the controller's fake mode (ameise --fake): it answers the calls the controller
# makes from a canned GitHub in a directory, so the real server runs with no GitHub behind it.
#
#   AMEISE_FAKE_GH      the canned GitHub; without it every login holds and no repository answers
#     logged-out                           present: gh auth status fails as a machine without a login does
#     repos/<owner>/<name>/default-branch  the default branch GitHub names for that repository
#     repos/<owner>/<name>/pulls.json      the open pull requests gh pr list answers for it
#     repos/<owner>/<name>/issues/<n>.json the issue gh issue view answers
#     repos/<owner>/<name>/unassignable    present: gh issue edit --add-assignee fails for it
#                                          (gh issue edit --remove-assignee @me always holds)
#     repos/<owner>/<name>/pulls/<n>.json  the pull request gh pr view answers
#     repos/<owner>/<name>/pulls/<n>.readings/
#                                          the readings gh pr view answers in their order before that,
#                                          one file each, in the order of their names, such as 000.json;
#                                          each call takes the next, and the last one stays; once gh pr
#                                          merge merged it, merged.json goes before them
#     repos/<owner>/<name>/pulls/<n>.body  written by gh pr create and gh pr edit --body-file where pulls/
#                                          exists: the body of the pull request it opened or edited
#     repos/<owner>/<name>/draft-<n>.json  written by gh pr create --draft: the draft it opened, by the
#                                          login below, which gh pr list answers after pulls.json, and
#                                          gh pr ready marks not a draft
#     repos/<owner>/<name>/pulls/<n>.merged.json
#                                          what gh pr view answers of it once gh pr merge merged it
#     repos/<owner>/<name>/pulls/<n>.merged
#                                          written by gh pr merge, which holds for a canned pull request
#     repos/<owner>/<name>/pulls/<n>.threads.json
#                                          the review threads of it, such as [{"isResolved": false}],
#                                          which gh api graphql answers; absent, it has none. A thread
#                                          written with its id first, as {"id":"T1","isResolved":false,
#                                          ...}, is resolved by the resolveReviewThread mutation
#     repos/<owner>/<name>/pulls/<n>.comments
#                                          written by gh pr comment --body-file: every comment on it
#     repos/<owner>/<name>/promotions.json the pull requests from dev to main gh pr list answers
#     repos/<owner>/<name>/next-pull       the number gh pr create gives the pull request it opens
#                                          (gh issue close, gh release create and gh api --method PATCH
#                                          always hold)
#     repos/<owner>/<name>/unreviewable    present: gh pr edit --add-reviewer fails for it, which holds
#                                          otherwise
#     api/<endpoint>                       the answer of gh api [--paginate] [--method <m>] [<field>]...
#                                          <endpoint>, such as
#                                          api/repos/<owner>/<name>/issues?labels=spec&state=open&per_page=100;
#                                          an endpoint that is also the directory of longer ones, such as
#                                          repos/<owner>/<name>/issues/30 beside issues/30/sub_issues, keeps
#                                          its answer in the file @ of that directory
#     api/<endpoint>.fails                 present: gh api <endpoint> fails with its content on stderr, as a
#                                          GitHub that answers an error other than not found does
#     api/<endpoint>.<METHOD>              written by gh api --method <METHOD> <endpoint> --input -, such as
#                                          api/repos/<owner>/<name>/issues.POST: every body it was sent, one
#                                          a line; it answers api/<endpoint> where that is canned, else {}
#     git/<owner>/<name>.git               the repository origin is in fake mode for the scripts of the
#                                          standardize process, which push and fetch (standardize.ts)
#     repos/<owner>/<name>/runs/<id>.log   the failed log gh run view <id> --log-failed answers
#     login                                the login gh api user answers; fake without it
#   AMEISE_FAKE_GH_LOG  every call, one request per line
#
# A request without an answer fails, as a GitHub that does not answer does.
set -euo pipefail

printf '%s\n' "$*" >> "${AMEISE_FAKE_GH_LOG:-/dev/null}"
canned=${AMEISE_FAKE_GH:-}

case "$*" in
  --version)
    printf 'gh version 0.0.0 (ameise fake)\n' ;;
  'auth status --active --hostname github.com')
    if [ -n "$canned" ] && [ -e "$canned/logged-out" ]; then
      printf 'You are not logged into any GitHub hosts. To log in, run: gh auth login\n' >&2
      exit 1
    fi
    printf 'github.com\n  Logged in to github.com account fake (ameise fake)\n' ;;
  'repo view '*' --json defaultBranchRef --jq .defaultBranchRef.name')
    repo=${3#github.com/}
    file="$canned/repos/$repo/default-branch"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'error: no canned repository %s\n' "$repo" >&2
      exit 1
    fi
    cat "$file" ;;
  'pr list --repo '*' --base main --head dev --state all --limit 100 --json '*)
    file="$canned/repos/$4/promotions.json"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'error: no canned promotions of %s\n' "$4" >&2
      exit 1
    fi
    cat "$file" ;;
  'pr view '*' --repo '*' --json '*)
    readings="$canned/repos/$5/pulls/$3.readings"
    merged="$canned/repos/$5/pulls/$3.merged"
    if [ -n "$canned" ] && [ -d "$readings" ] && ! { [ -e "$merged" ] && [ -f "$merged.json" ]; }; then
      queue=("$readings"/*.json)
      if [ -f "${queue[0]}" ]; then
        # .taken counts the readings answered, as the PATH of a test holds no rm.
        taken=0
        if [ -f "$readings/.taken" ]; then taken=$(< "$readings/.taken"); fi
        if [ "$taken" -ge ${#queue[@]} ]; then taken=$((${#queue[@]} - 1)); fi
        cat "${queue[$taken]}"
        printf '%s\n' $((taken + 1)) > "$readings/.taken"
        exit 0
      fi
    fi
    file="$canned/repos/$5/pulls/$3.json"
    if [ -n "$canned" ] && [ -e "$canned/repos/$5/pulls/$3.merged" ] && [ -f "$canned/repos/$5/pulls/$3.merged.json" ]; then
      file="$canned/repos/$5/pulls/$3.merged.json"
    fi
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'GraphQL: Could not resolve to a PullRequest with the number of %s. (repository.pullRequest)\n' "$3" >&2
      exit 1
    fi
    cat "$file" ;;
  'pr merge '*' --repo '*)
    if [ -z "$canned" ] || [ ! -f "$canned/repos/$5/pulls/$3.json" ]; then
      printf 'GraphQL: Could not resolve to a PullRequest with the number of %s. (repository.pullRequest)\n' "$3" >&2
      exit 1
    fi
    : > "$canned/repos/$5/pulls/$3.merged" ;;
  'pr create --repo '*' --base main --head dev '*)
    file="$canned/repos/$4/next-pull"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'pull request create failed: no canned next pull request of %s\n' "$4" >&2
      exit 1
    fi
    printf 'https://github.com/%s/pull/%s\n' "$4" "$(cat "$file")" ;;
  'pr create --repo '*' --base '*' --head '*' --title '*' --body-file '*)
    file="$canned/repos/$4/next-pull"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'pull request create failed: no canned next pull request of %s\n' "$4" >&2
      exit 1
    fi
    n=$(cat "$file")
    if [ -d "$canned/repos/$4/pulls" ]; then cat "${12}" > "$canned/repos/$4/pulls/$n.body"; fi
    if [ "${13:-}" = --draft ]; then
      login=fake
      if [ -f "$canned/login" ]; then login=$(cat "$canned/login"); fi
      printf '{"number":%s,"headRefName":"%s","baseRefName":"%s","isCrossRepository":false,"isDraft":true,"url":"https://github.com/%s/pull/%s","author":{"login":"%s"}}\n' \
        "$n" "$8" "$6" "$4" "$n" "$login" > "$canned/repos/$4/draft-$n.json"
    fi
    printf 'https://github.com/%s/pull/%s\n' "$4" "$n" ;;
  'pr edit '*' --repo '*' --add-reviewer '*)
    if [ -n "$canned" ] && [ -e "$canned/repos/$5/unreviewable" ]; then
      printf 'could not request reviewer: %s is not a collaborator\n' "$7" >&2
      exit 1
    fi
    printf 'https://github.com/%s/pull/%s\n' "$5" "$3" ;;
  'pr edit '*' --repo '*' --title '*' --body-file '*)
    if [ -n "$canned" ] && [ -d "$canned/repos/$5/pulls" ]; then cat "$9" > "$canned/repos/$5/pulls/$3.body"; fi
    printf 'https://github.com/%s/pull/%s\n' "$5" "$3" ;;
  'pr ready '*' --repo '*)
    if [ -n "$canned" ] && [ -f "$canned/repos/$5/draft-$3.json" ]; then
      draft=$(cat "$canned/repos/$5/draft-$3.json")
      printf '%s\n' "${draft/\"isDraft\":true/\"isDraft\":false}" > "$canned/repos/$5/draft-$3.json"
    fi
    printf 'Pull request %s#%s is marked as "ready for review"\n' "$5" "$3" ;;
  'release create '*' --repo '*)
    printf 'https://github.com/%s/releases/tag/%s\n' "$5" "$3" ;;
  'issue close '*' --repo '*)
    printf 'Closed issue %s#%s\n' "$5" "$3" ;;
  'api '*' --input -')
    args=("$@")
    endpoint=${args[$# - 3]}
    method=POST
    for ((i = 1; i < $# - 1; i++)); do
      if [ "${args[$i]}" = --method ]; then method=${args[$i + 1]}; fi
    done
    case "$endpoint" in *..* | '' | -*)
      printf 'error: the fake gh has no answer to: gh %s\n' "$*" >&2
      exit 1 ;;
    esac
    body=$(cat)
    if [ -z "$canned" ]; then
      printf '{}\n'
      exit 0
    fi
    mkdir -p "$(dirname "$canned/api/$endpoint")"
    printf '%s\n' "$(tr -d '\n' <<<"$body")" >> "$canned/api/$endpoint.$method"
    file="$canned/api/$endpoint"
    if [ -d "$file" ]; then file="$file/@"; fi
    if [ -f "$file" ]; then cat "$file"; else printf '{}\n'; fi ;;
  'api --method PATCH '*)
    printf '{}\n' ;;
  'repo view --json nameWithOwner -q .nameWithOwner')
    # The repository of the checkout it runs in, by the origin it was cloned from.
    origin=$(git config --get remote.origin.url 2>/dev/null || true)
    nwo=${origin#*github.com[:/]}
    nwo=${nwo%.git}
    if [ "$nwo" = "$origin" ] || [ -z "$nwo" ]; then
      printf 'none of the git remotes configured for this repository point to a known GitHub host\n' >&2
      exit 1
    fi
    printf '%s\n' "$nwo" ;;
  'pr list --repo '*' --state open --limit 100 --json '*)
    file="$canned/repos/$4/pulls.json"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'error: no canned pull requests of %s\n' "$4" >&2
      exit 1
    fi
    list=$(cat "$file")
    for draft in "$canned/repos/$4"/draft-*.json; do
      if [ ! -f "$draft" ]; then continue; fi
      list=${list%]}
      case "$list" in
        *'[') list="$list$(cat "$draft")]" ;;
        *) list="$list,$(cat "$draft")]" ;;
      esac
    done
    printf '%s\n' "$list" ;;
  'api user --jq .login')
    if [ -n "$canned" ] && [ -f "$canned/login" ]; then cat "$canned/login"; else printf 'fake\n'; fi ;;
  'run view '*' --repo '*' --log-failed')
    file="$canned/repos/$5/runs/$3.log"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'failed to get run log: no canned log of run %s\n' "$3" >&2
      exit 1
    fi
    cat "$file" ;;
  'issue view '*' --repo '*' --json number,title,state,labels')
    file="$canned/repos/$5/issues/$3.json"
    if [ -z "$canned" ] || [ ! -f "$file" ]; then
      printf 'GraphQL: Could not resolve to an issue or pull request with the number of %s. (repository.issue)\n' "$3" >&2
      exit 1
    fi
    cat "$file" ;;
  'issue edit '*' --repo '*' --add-assignee @me')
    if [ -z "$canned" ] || [ -e "$canned/repos/$5/unassignable" ]; then
      printf 'failed to update https://github.com/%s/issues/%s: could not assign\n' "$5" "$3" >&2
      exit 1
    fi
    printf 'https://github.com/%s/issues/%s\n' "$5" "$3" ;;
  'issue edit '*' --repo '*' --remove-assignee @me')
    printf 'https://github.com/%s/issues/%s\n' "$5" "$3" ;;
  'pr comment '*' --repo '*' --body-file '*)
    if [ -z "$canned" ] || [ ! -d "$canned/repos/$5/pulls" ]; then
      printf 'GraphQL: Could not resolve to a PullRequest with the number of %s. (repository.pullRequest)\n' "$3" >&2
      exit 1
    fi
    cat "$7" >> "$canned/repos/$5/pulls/$3.comments"
    printf '\n' >> "$canned/repos/$5/pulls/$3.comments"
    printf 'https://github.com/%s/pull/%s#issuecomment-1\n' "$5" "$3" ;;
  'api graphql -f threadId='*' -f body='*' -f query='*)
    printf '{"data":{"addPullRequestReviewThreadReply":{"comment":{"url":"https://github.com/fake/reply/%s"}}}}\n' "${4#threadId=}" ;;
  'api graphql -f threadId='*' -f query='*)
    id=${4#threadId=}
    if [ -n "$canned" ]; then
      for file in "$canned"/repos/*/*/pulls/*.threads.json; do
        if [ ! -f "$file" ]; then continue; fi
        threads=$(cat "$file")
        open="\"id\":\"$id\",\"isResolved\":false"
        resolved="\"id\":\"$id\",\"isResolved\":true"
        printf '%s\n' "${threads//"$open"/$resolved}" > "$file"
      done
    fi
    printf '{"data":{"resolveReviewThread":{"thread":{"isResolved":true}}}}\n' ;;
  'api graphql -F owner='*' -F name='*' -F number='*' -f query='*)
    file="$canned/repos/${4#owner=}/${6#name=}/pulls/${8#number=}.threads.json"
    threads='[]'
    if [ -n "$canned" ] && [ -f "$file" ]; then threads=$(cat "$file"); fi
    printf '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":%s}}}}}\n' "$threads" ;;
  'api '*)
    endpoint=${!#}
    file="$canned/api/$endpoint"
    case "$endpoint" in *..*) file='' ;; esac
    if [ -n "$canned" ] && [ -n "$file" ] && [ -f "$file.fails" ]; then
      cat "$file.fails" >&2
      exit 1
    fi
    if [ -n "$file" ] && [ -d "$file" ]; then file="$file/@"; fi
    if [ -z "$canned" ] || [ -z "$file" ] || [ ! -f "$file" ]; then
      printf 'gh: Not Found (HTTP 404): %s\n' "$endpoint" >&2
      exit 1
    fi
    cat "$file" ;;
  *)
    printf 'error: the fake gh has no answer to: gh %s\n' "$*" >&2
    exit 1 ;;
esac
