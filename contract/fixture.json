      {
        "case": "the explicit setting wins",
        "explicit": "dev",
        "origin_head": "trunk",
        "github_default": "release",
        "base": "dev"
      },
      {
        "case": "then the head of the remote",
        "explicit": "",
        "origin_head": "trunk",
        "github_default": "release",
        "base": "trunk"
      },
      {
        "case": "then the default branch on GitHub",
        "explicit": "",
        "origin_head": "",
        "github_default": "release",
        "base": "release"
      },
      {
        "case": "and main when nothing answers",
        "explicit": "",
        "origin_head": "",
        "github_default": "",
        "base": "main"
      }
